{
  "name": "brainbytes-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for BrainBytes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "../scripts",
          "outputName": "test-report.xml"
        }
      ]
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.15",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "express-validator": "^7.3.2",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^9.6.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
  }
}
