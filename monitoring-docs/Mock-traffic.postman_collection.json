    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 2xx\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    const response = pm.response.json();",
              "    if (response.data && response.data.id) {",
              "        const createdId = response.data.id;",
              "        pm.environment.set(\"latest_user_id\", createdId);",
              "        console.log(\"🔄 Variable Updated! Saved ID: \" + createdId);",
              "    } else {",
              "        console.warn(\"⚠️ Request succeeded, but 'id' missing from data layout.\");",
              "    }",
              "} else {",
              "    const response = pm.response.json();",
              "    console.error(`❌ Request Failed with Status ${pm.response.code}: ${response.message}`);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
